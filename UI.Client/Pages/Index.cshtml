@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<!-- Codebehind (IndexModel) => alias @Model -->

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage) || Model.QotdDto is null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else
{
    <div class="container">
        <div class="text-center">
            <div class="p-2 bg-light rounded-3">
                <h5 class="display-6 py-3">Spruch des Tages</h5>
                <p class="text-center">
                    <!-- Bild anzeigen  -->
                    @if(Model.QotdDto.AuthorPhoto is not null)
                    {
                        <!-- Data-URI: src="data:MIMETYPE;base64,NUTZDATEN" -->
                        <img width="150" src="data:@Model.QotdDto.AuthorPhotoMimeType;base64,@Convert.ToBase64String(Model.QotdDto.AuthorPhoto)" />
                    }
                    else
                    {
                        <img width="150" src="https://placehold.co/150" />
                    }
                </p>
                <blockquote class="text-center">
                    <p class="lead fw-bold" id="quote">@Model.QotdDto.QuoteText</p>
                    <cite>
                        <span>@Model.QotdDto.AuthorName - @Model.QotdDto.AuthorDescription</span>
                        <br />
                        <span>
                            @(Model.QotdDto.AuthorBirthDate is not null ? Model.QotdDto.AuthorBirthDate.Value.ToShortDateString() : "k.A.")
                        </span>
                    </cite>
                </blockquote>
            </div>
        </div>
    </div>
}


